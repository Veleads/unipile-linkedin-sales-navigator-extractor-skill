UNIPILE_API_KEY=
UNIPILE_DSN=

# Optional. Randomized pause before each Sales Navigator / company-profile call.
DELAY_MIN_MS=2500
DELAY_MAX_MS=6500
MAX_RETRIES=4
# OUTPUT_DIR=output

# Optional. LinkedIn geo id for classic job search. Default 92000000 (Worldwide).
# Germany is 101282230.
# JOB_REGION=92000000

# Optional. Connect hook (npm run connect).
# CONNECT_HOOK_PORT=8787
# Requires ?t=<token> on the shared link. Leave empty for no token.
# CONNECT_HOOK_TOKEN=
# Only used with --no-tunnel, when you run your own tunnel. No trailing slash.
# CONNECT_HOOK_PUBLIC_URL=https://connect.example.com
# Path to an existing cloudflared. Otherwise one is downloaded to .cache/ once.
# CLOUDFLARED_BIN=
